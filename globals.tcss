/* Header and Footer dock themselves to the top and bottom, so #body is the
   only child left in Screen's normal layout flow. */
#body {
    height: 1fr;
}

#lesson-section {
    height: 1fr;
    width: 34;
    border: solid green;
}

#lessons-title {
    text-style: bold;
    margin-bottom: 1;
}

#lesson-list {
    width: 32;
}

#lesson-list>LessonItem>Label {
    width: 95%;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    padding: 1 0 1 0
}

#detail {
    width: 1fr;
}

#summary {
    height: 0.25fr;
    border: solid green;
    padding: 1 2;
}

#log {
    height: 1fr;
    border: solid green;
    padding: 0 1;
}